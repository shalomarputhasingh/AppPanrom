    "toast_kaattu": {
      "min": 1,
      "max": 1,
      "doc": "toast_kaattu(value) - short transient message"
    },
    "debug_log": {
      "min": 1,
      "max": 1,
      "doc": "debug_log(value) - console debug line"
    },
    "warning_kaattu": {
      "min": 1,
      "max": 1,
