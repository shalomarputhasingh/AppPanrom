{
  "spec_version": 1,
  "themes": [
    "light",
    "dark"
  ],
  "config_functions": {
    "app_uruvakku": {
      "args": [
        "str"
      ],
      "doc": "app_uruvakku(name) - app display name"
    },
    "app_id_set": {
      "args": [
        "str"
      ],
      "doc": "app_id_set(\"com.example.app\") - Android application id"
    },
    "app_version_set": {
      "args": [
        "str"
      ],
      "doc": "app_version_set(\"1.0.0\") - version name (MAJOR.MINOR.PATCH)"
    },
    "app_theme_set": {
      "args": [
        "str"
      ],
      "doc": "app_theme_set(\"light\" | \"dark\")"
    },
    "app_start_screen": {
      "args": [
        "str"
      ],
      "doc": "app_start_screen(\"home\") - screen shown first (default: first declared)"
    }
  },
  "style_groups": {
    "box": [
      "background",
      "padding",
      "margin",
      "width",
      "height",
      "corner_radius",
      "border_width",
      "border_color",
      "opacity",
      "visible",
      "shadow",
      "clay",
      "background_to",
      "gradient_angle",
      "glass",
      "neumorphic",
      "brutal",
      "animate",
      "animate_duration",
      "animate_delay"
    ],
    "text": [
      "text_color",
      "font_size",
      "font_weight",
      "text_align"
    ],
    "flow": [
      "gap",
      "align",
      "justify",
      "wrap",
      "scroll"
    ]
  },
  "styles": {
    "background": {
      "type": "color"
    },
    "text_color": {
      "type": "color"
    },
    "border_color": {
      "type": "color"
    },
    "padding": {
      "type": "number",
      "min": 0,
      "max": 200
    },
    "margin": {
      "type": "number",
      "min": 0,
      "max": 200
    },
    "gap": {
      "type": "number",
      "min": 0,
      "max": 200
    },
    "corner_radius": {
      "type": "number",
      "min": 0,
      "max": 200
    },
    "border_width": {
      "type": "number",
      "min": 0,
      "max": 20
    },
    "font_size": {
      "type": "number",
      "min": 8,
      "max": 96
    },
    "opacity": {
      "type": "number",
      "min": 0,
      "max": 1
    },
    "width": {
      "type": "size"
    },
    "height": {
      "type": "size"
    },
    "font_weight": {
      "type": "enum",
      "values": [
        "normal",
        "medium",
        "bold"
      ]
    },
    "text_align": {
      "type": "enum",
      "values": [
        "left",
        "center",
        "right"
      ]
    },
    "align": {
      "type": "enum",
      "values": [
        "start",
        "center",
        "end",
        "stretch"
      ]
    },
    "justify": {
      "type": "enum",
      "values": [
        "start",
        "center",
        "end",
        "space_between",
        "space_around"
      ]
    },
    "wrap": {
      "type": "bool"
    },
    "scroll": {
      "type": "bool"
    },
    "visible": {
      "type": "bool"
    },
    "shadow": {
      "type": "enum",
      "values": [
        "none",
        "soft",
        "medium",
        "strong"
      ]
    },
    "clay": {
      "type": "bool"
    },
    "background_to": {
      "type": "color"
    },
    "gradient_angle": {
      "type": "number",
      "min": 0,
      "max": 360
    },
    "glass": {
      "type": "bool"
    },
    "neumorphic": {
      "type": "bool"
    },
    "brutal": {
      "type": "bool"
    },
    "animate": {
      "type": "enum",
      "values": [
        "none",
        "fade_in",
        "slide_up",
        "slide_down",
        "slide_left",
        "slide_right",
        "zoom_in",
        "pop",
        "bounce",
        "shake",
        "pulse",
        "float",
        "spin"
      ]
    },
    "animate_duration": {
      "type": "number",
      "min": 0.1,
      "max": 10
    },
    "animate_delay": {
      "type": "number",
      "min": 0,
      "max": 10
    }
  },
  "unsupported_styles": [
    "gradient",
    "font_family",
    "text_decor",
    "line_height"
  ],
  "screen_style_groups": [
    "box",
    "text",
    "flow"
  ],
  "components": {
    "title": {
      "container": false,
      "positional": [
        {
          "name": "text",
          "type": "any",
          "required": true
        }
      ],
      "kwargs": {},
      "events": [],
      "style_groups": [
        "box",
        "text"
      ],
      "doc": "title(text, style={}) - large heading"
    },
    "text_kaattu": {
      "container": false,
      "positional": [
        {
          "name": "text",
          "type": "any",
          "required": true
        }
      ],
      "kwargs": {},
      "events": [],
      "style_groups": [
        "box",
        "text"
      ],
      "doc": "text_kaattu(text, style={}) - paragraph text"
    },
    "button": {
      "container": false,
      "positional": [
        {
          "name": "label",
          "type": "any",
          "required": true
        }
      ],
      "kwargs": {
        "enabled": "bool"
      },
      "events": [
        "click_pannumbodhu"
      ],
      "style_groups": [
        "box",
        "text"
      ],
      "doc": "button(label, click_pannumbodhu=handler, enabled=true, style={})"
    },
    "input_uruvakku": {
      "container": false,
      "positional": [
        {
          "name": "name",
          "type": "str",
          "required": true
        }
      ],
      "kwargs": {
        "label": "str",
        "placeholder": "str",
        "initial": "str",
        "enabled": "bool"
      },
      "events": [
        "change_aagumbodhu",
        "submit_pannumbodhu"
      ],
      "style_groups": [
        "box",
        "text"
      ],
      "input": "text",
      "doc": "input_uruvakku(name, label=\"\", placeholder=\"\", initial=\"\", change_aagumbodhu=handler, submit_pannumbodhu=handler)"
    },
    "password_input": {
      "container": false,
      "positional": [
        {
          "name": "name",
          "type": "str",
          "required": true
        }
      ],
      "kwargs": {
        "label": "str",
        "placeholder": "str",
        "initial": "str",
        "enabled": "bool"
      },
      "events": [
        "change_aagumbodhu",
        "submit_pannumbodhu"
      ],
      "style_groups": [
        "box",
        "text"
      ],
      "input": "password",
      "doc": "password_input(name, label=\"\", placeholder=\"\")"
    },
    "number_input": {
      "container": false,
      "positional": [
        {
          "name": "name",
          "type": "str",
          "required": true
        }
      ],
      "kwargs": {
        "label": "str",
        "placeholder": "str",
        "initial": "num",
        "enabled": "bool"
      },
      "events": [
        "change_aagumbodhu",
        "submit_pannumbodhu"
      ],
      "style_groups": [
        "box",
        "text"
      ],
      "input": "number",
      "doc": "number_input(name, label=\"\", placeholder=\"\", initial=0) - input_value returns a number or null"
    },
    "checkbox_uruvakku": {
      "container": false,
      "positional": [
        {
          "name": "name",
          "type": "str",
          "required": true
        }
      ],
      "kwargs": {
        "label": "str",
        "initial": "bool",
        "enabled": "bool"
      },
      "events": [
        "change_aagumbodhu"
      ],
      "style_groups": [
        "box",
        "text"
      ],
      "input": "checkbox",
      "doc": "checkbox_uruvakku(name, label=\"\", initial=false)"
    },
    "toggle_uruvakku": {
      "container": false,
      "positional": [
        {
          "name": "name",
          "type": "str",
          "required": true
        }
      ],
      "kwargs": {
        "label": "str",
        "initial": "bool",
        "enabled": "bool"
      },
      "events": [
        "change_aagumbodhu"
      ],
      "style_groups": [
        "box",
        "text"
      ],
      "input": "toggle",
      "doc": "toggle_uruvakku(name, label=\"\", initial=false)"
    },
    "dropdown_uruvakku": {
      "container": false,
      "positional": [
        {
          "name": "name",
          "type": "str",
          "required": true
        }
      ],
      "kwargs": {
        "options": "list",
        "label": "str",
        "initial": "str",
        "enabled": "bool"
      },
      "events": [
        "change_aagumbodhu"
      ],
      "style_groups": [
        "box",
        "text"
      ],
      "input": "dropdown",
      "doc": "dropdown_uruvakku(name, options=[\"a\", \"b\"], label=\"\", initial=\"a\")"
    },
    "image_kaattu": {
      "container": false,
      "positional": [
        {
          "name": "src",
          "type": "str",
          "required": true
        }
      ],
      "kwargs": {
        "alt": "str"
      },
      "events": [],
      "style_groups": [
        "box"
      ],
      "doc": "image_kaattu(src, alt=\"\") - src must be an https:// URL or data:image/ URI"
    },
    "list_kaattu": {
      "container": false,
      "positional": [
        {
          "name": "items",
          "type": "list",
          "required": true
        }
      ],
      "kwargs": {},
      "events": [],
      "style_groups": [
        "box",
        "text",
        "flow"
      ],
      "doc": "list_kaattu(items) - one row per item"
    },
    "progress_kaattu": {
      "container": false,
      "positional": [
        {
          "name": "value",
          "type": "num",
          "required": true
        }
      ],
      "kwargs": {
        "label": "str"
      },
      "events": [],
      "style_groups": [
        "box"
      ],
      "doc": "progress_kaattu(value, label=\"\") - value from 0 to 100"
    },
    "loading_kaattu": {
      "container": false,
      "positional": [],
      "kwargs": {
        "label": "str"
      },
      "events": [],
      "style_groups": [
        "box",
        "text"
      ],
      "doc": "loading_kaattu(label=\"\") - spinner"
    },
    "divider_kaattu": {
      "container": false,
      "positional": [],
      "kwargs": {},
      "events": [],
      "style_groups": [
        "box"
      ],
      "doc": "divider_kaattu() - horizontal line"
    },
    "card_uruvakku": {
      "container": true,
      "positional": [],
      "kwargs": {},
      "events": [],
      "style_groups": [
        "box",
        "text",
        "flow"
      ],
      "doc": "card_uruvakku(style={}): <block> - raised container"
    },
    "column_uruvakku": {
      "container": true,
      "positional": [],
      "kwargs": {},
      "events": [],
      "style_groups": [
        "box",
        "text",
        "flow"
      ],
      "doc": "column_uruvakku(style={}): <block> - vertical layout"
    },
    "row_uruvakku": {
      "container": true,
      "positional": [],
      "kwargs": {},
      "events": [],
      "style_groups": [
        "box",
        "text",
        "flow"
      ],
      "doc": "row_uruvakku(style={}): <block> - horizontal layout"
    },
    "center_ama": {
      "container": true,
      "positional": [],
      "kwargs": {},
      "events": [],
      "style_groups": [
        "box",
        "text",
        "flow"
      ],
      "doc": "center_ama(style={}): <block> - centers children horizontally and vertically"
    },
    "navbar_uruvakku": {
      "container": true,
      "positional": [],
      "kwargs": {
        "title": "str",
        "subtitle": "str",
        "align": "str",
        "back": "bool",
        "visible": "bool"
      },
      "events": [],
      "style_groups": [
        "box",
        "text"
      ],
      "doc": "navbar_uruvakku(title=\"\", subtitle=\"\", align=\"left\", back=true, visible=true, style={}) [: nav_action children] - the top bar of this screen (the block is optional; visible=false removes the bar; align is left, center or right)"
    },
