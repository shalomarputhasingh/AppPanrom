{
  "spec_version": 1,
  "themes": ["light", "dark"],
  "config_functions": {
    "app_uruvakku":     {"args": ["str"], "doc": "app_uruvakku(name) - app display name"},
    "app_id_set":       {"args": ["str"], "doc": "app_id_set(\"com.example.app\") - Android application id"},
    "app_version_set":  {"args": ["str"], "doc": "app_version_set(\"1.0.0\") - version name (MAJOR.MINOR.PATCH)"},
    "app_theme_set":    {"args": ["str"], "doc": "app_theme_set(\"light\" | \"dark\")"},
    "app_start_screen": {"args": ["str"], "doc": "app_start_screen(\"home\") - screen shown first (default: first declared)"}
  },
  "style_groups": {
    "box":  ["background", "padding", "margin", "width", "height", "corner_radius", "border_width", "border_color", "opacity", "visible"],
    "text": ["text_color", "font_size", "font_weight", "text_align"],
    "flow": ["gap", "align", "justify", "wrap", "scroll"]
  },
  "styles": {
    "background":    {"type": "color"},
    "text_color":    {"type": "color"},
    "border_color":  {"type": "color"},
    "padding":       {"type": "number", "min": 0, "max": 200},
    "margin":        {"type": "number", "min": 0, "max": 200},
    "gap":           {"type": "number", "min": 0, "max": 200},
    "corner_radius": {"type": "number", "min": 0, "max": 200},
    "border_width":  {"type": "number", "min": 0, "max": 20},
    "font_size":     {"type": "number", "min": 8, "max": 96},
    "opacity":       {"type": "number", "min": 0, "max": 1},
    "width":         {"type": "size"},
    "height":        {"type": "size"},
    "font_weight":   {"type": "enum", "values": ["normal", "medium", "bold"]},
    "text_align":    {"type": "enum", "values": ["left", "center", "right"]},
    "align":         {"type": "enum", "values": ["start", "center", "end", "stretch"]},
    "justify":       {"type": "enum", "values": ["start", "center", "end", "space_between", "space_around"]},
    "wrap":          {"type": "bool"},
    "scroll":        {"type": "bool"},
    "visible":       {"type": "bool"}
  },
  "unsupported_styles": ["gradient", "shadow", "font_family", "text_decor", "line_height"],
  "screen_style_groups": ["box", "text", "flow"],
  "components": {
    "title":             {"container": false, "positional": [{"name": "text", "type": "any", "required": true}], "kwargs": {}, "events": [], "style_groups": ["box", "text"], "doc": "title(text, style={}) - large heading"},
    "text_kaattu":       {"container": false, "positional": [{"name": "text", "type": "any", "required": true}], "kwargs": {}, "events": [], "style_groups": ["box", "text"], "doc": "text_kaattu(text, style={}) - paragraph text"},
    "button":            {"container": false, "positional": [{"name": "label", "type": "any", "required": true}], "kwargs": {"enabled": "bool"}, "events": ["click_pannumbodhu"], "style_groups": ["box", "text"], "doc": "button(label, click_pannumbodhu=handler, enabled=true, style={})"},
    "input_uruvakku":    {"container": false, "positional": [{"name": "name", "type": "str", "required": true}], "kwargs": {"label": "str", "placeholder": "str", "initial": "str", "enabled": "bool"}, "events": ["change_aagumbodhu", "submit_pannumbodhu"], "style_groups": ["box", "text"], "input": "text", "doc": "input_uruvakku(name, label=\"\", placeholder=\"\", initial=\"\", change_aagumbodhu=handler, submit_pannumbodhu=handler)"},
    "password_input":    {"container": false, "positional": [{"name": "name", "type": "str", "required": true}], "kwargs": {"label": "str", "placeholder": "str", "initial": "str", "enabled": "bool"}, "events": ["change_aagumbodhu", "submit_pannumbodhu"], "style_groups": ["box", "text"], "input": "password", "doc": "password_input(name, label=\"\", placeholder=\"\")"},
    "number_input":      {"container": false, "positional": [{"name": "name", "type": "str", "required": true}], "kwargs": {"label": "str", "placeholder": "str", "initial": "num", "enabled": "bool"}, "events": ["change_aagumbodhu", "submit_pannumbodhu"], "style_groups": ["box", "text"], "input": "number", "doc": "number_input(name, label=\"\", placeholder=\"\", initial=0) - input_value returns a number or null"},
    "checkbox_uruvakku": {"container": false, "positional": [{"name": "name", "type": "str", "required": true}], "kwargs": {"label": "str", "initial": "bool", "enabled": "bool"}, "events": ["change_aagumbodhu"], "style_groups": ["box", "text"], "input": "checkbox", "doc": "checkbox_uruvakku(name, label=\"\", initial=false)"},
    "toggle_uruvakku":   {"container": false, "positional": [{"name": "name", "type": "str", "required": true}], "kwargs": {"label": "str", "initial": "bool", "enabled": "bool"}, "events": ["change_aagumbodhu"], "style_groups": ["box", "text"], "input": "toggle", "doc": "toggle_uruvakku(name, label=\"\", initial=false)"},
    "dropdown_uruvakku": {"container": false, "positional": [{"name": "name", "type": "str", "required": true}], "kwargs": {"options": "list", "label": "str", "initial": "str", "enabled": "bool"}, "events": ["change_aagumbodhu"], "style_groups": ["box", "text"], "input": "dropdown", "doc": "dropdown_uruvakku(name, options=[\"a\", \"b\"], label=\"\", initial=\"a\")"},
    "image_kaattu":      {"container": false, "positional": [{"name": "src", "type": "str", "required": true}], "kwargs": {"alt": "str"}, "events": [], "style_groups": ["box"], "doc": "image_kaattu(src, alt=\"\") - src must be an https:// URL or data:image/ URI"},
    "list_kaattu":       {"container": false, "positional": [{"name": "items", "type": "list", "required": true}], "kwargs": {}, "events": [], "style_groups": ["box", "text", "flow"], "doc": "list_kaattu(items) - one row per item"},
    "progress_kaattu":   {"container": false, "positional": [{"name": "value", "type": "num", "required": true}], "kwargs": {"label": "str"}, "events": [], "style_groups": ["box"], "doc": "progress_kaattu(value, label=\"\") - value from 0 to 100"},
    "loading_kaattu":    {"container": false, "positional": [], "kwargs": {"label": "str"}, "events": [], "style_groups": ["box", "text"], "doc": "loading_kaattu(label=\"\") - spinner"},
    "divider_kaattu":    {"container": false, "positional": [], "kwargs": {}, "events": [], "style_groups": ["box"], "doc": "divider_kaattu() - horizontal line"},
    "card_uruvakku":     {"container": true, "positional": [], "kwargs": {}, "events": [], "style_groups": ["box", "text", "flow"], "doc": "card_uruvakku(style={}): <block> - raised container"},
    "column_uruvakku":   {"container": true, "positional": [], "kwargs": {}, "events": [], "style_groups": ["box", "text", "flow"], "doc": "column_uruvakku(style={}): <block> - vertical layout"},
    "row_uruvakku":      {"container": true, "positional": [], "kwargs": {}, "events": [], "style_groups": ["box", "text", "flow"], "doc": "row_uruvakku(style={}): <block> - horizontal layout"},
    "center_ama":        {"container": true, "positional": [], "kwargs": {}, "events": [], "style_groups": ["box", "text", "flow"], "doc": "center_ama(style={}): <block> - centers children horizontally and vertically"}
  },
  "screen_functions": {
    "screen_title": {"min": 1, "max": 1, "doc": "screen_title(text) - app bar title of the current screen (inside a screen block)"}
  },
  "functions": {
    "message_kaattu":    {"min": 1, "max": 1, "doc": "message_kaattu(value) - modal message with OK"},
    "toast_kaattu":      {"min": 1, "max": 1, "doc": "toast_kaattu(value) - short transient message"},
    "debug_log":         {"min": 1, "max": 1, "doc": "debug_log(value) - console debug line"},
    "warning_kaattu":    {"min": 1, "max": 1, "doc": "warning_kaattu(value) - console warning"},
    "error_kaattu":      {"min": 1, "max": 1, "doc": "error_kaattu(value) - console error"},
    "int":               {"min": 1, "max": 1, "doc": "int(value) - number or numeric text to integer"},
    "float":             {"min": 1, "max": 1, "doc": "float(value) - number or numeric text to number"},
    "str":               {"min": 1, "max": 1, "doc": "str(value) - text form of any value"},
    "bool":              {"min": 1, "max": 1, "doc": "bool(value) - truthiness"},
    "type_of":           {"min": 1, "max": 1, "doc": "type_of(value) - \"number\" | \"text\" | \"bool\" | \"list\" | \"dict\" | \"null\""},
    "text_length":       {"min": 1, "max": 1, "arg_types": ["str"], "doc": "text_length(text)"},
    "text_upper":        {"min": 1, "max": 1, "arg_types": ["str"], "doc": "text_upper(text)"},
    "text_lower":        {"min": 1, "max": 1, "arg_types": ["str"], "doc": "text_lower(text)"},
    "text_trim":         {"min": 1, "max": 1, "arg_types": ["str"], "doc": "text_trim(text)"},
    "text_replace":      {"min": 3, "max": 3, "arg_types": ["str", "str", "str"], "doc": "text_replace(text, old, new)"},
    "text_split":        {"min": 2, "max": 2, "arg_types": ["str", "str"], "doc": "text_split(text, separator)"},
    "text_join":         {"min": 2, "max": 2, "arg_types": ["list", "str"], "doc": "text_join(items, separator)"},
    "text_contains":     {"min": 2, "max": 2, "arg_types": ["str", "str"], "doc": "text_contains(text, part)"},
    "length":            {"min": 1, "max": 1, "doc": "length(list_or_dict)"},
    "append":            {"min": 2, "max": 2, "arg_types": ["list", "any"], "doc": "append(list, value) - adds in place"},
    "remove":            {"min": 2, "max": 2, "arg_types": ["list", "num"], "doc": "remove(list, index) - removes in place, returns removed value"},
    "sort":              {"min": 1, "max": 1, "arg_types": ["list"], "doc": "sort(list) - new sorted list (all numbers or all text)"},
    "range":             {"min": 1, "max": 2, "arg_types": ["num", "num"], "doc": "range(stop) or range(start, stop)"},
    "dict_get":          {"min": 2, "max": 3, "arg_types": ["dict", "str", "any"], "doc": "dict_get(dict, key, default=null)"},
    "dict_keys":         {"min": 1, "max": 1, "arg_types": ["dict"], "doc": "dict_keys(dict)"},
    "min":               {"min": 1, "max": 2, "doc": "min(list) or min(a, b)"},
    "max":               {"min": 1, "max": 2, "doc": "max(list) or max(a, b)"},
    "sum":               {"min": 1, "max": 1, "arg_types": ["list"], "doc": "sum(list_of_numbers)"},
    "round":             {"min": 1, "max": 2, "arg_types": ["num", "num"], "doc": "round(value, digits=0)"},
    "abs":               {"min": 1, "max": 1, "arg_types": ["num"], "doc": "abs(value)"},
    "json_encode":       {"min": 1, "max": 1, "doc": "json_encode(value) -> text"},
    "json_decode":       {"min": 1, "max": 1, "arg_types": ["str"], "doc": "json_decode(text) -> value (raises error on bad JSON)"},
    "now_iso":           {"min": 0, "max": 0, "doc": "now_iso() - current UTC time, ISO 8601 text"},
    "random_number":     {"min": 2, "max": 2, "arg_types": ["num", "num"], "doc": "random_number(low, high) - random integer, both ends included (not cryptographically secure)"},
    "random_choice":     {"min": 1, "max": 1, "arg_types": ["list"], "doc": "random_choice(list) - random item (not cryptographically secure)"},
    "input_value":       {"min": 1, "max": 1, "arg_types": ["str"], "doc": "input_value(name) - current value of an input component"},
    "input_set":         {"min": 2, "max": 2, "arg_types": ["str", "any"], "doc": "input_set(name, value) - set an input component's value"},
    "data_save_pannu":   {"min": 2, "max": 2, "arg_types": ["str", "any"], "doc": "data_save_pannu(key, value) - persist JSON-compatible value (app-local, not encrypted)"},
    "data_edu":          {"min": 1, "max": 2, "arg_types": ["str", "any"], "doc": "data_edu(key, default=null) - read persisted value"},
    "data_delete_pannu": {"min": 1, "max": 1, "arg_types": ["str"], "doc": "data_delete_pannu(key)"},
    "data_clear_pannu":  {"min": 0, "max": 0, "doc": "data_clear_pannu() - remove all of this app's persisted data"},
    "screen_ku_poo":     {"min": 1, "max": 1, "arg_types": ["str"], "doc": "screen_ku_poo(name) - navigate to a screen"},
    "screen_back_poo":   {"min": 0, "max": 0, "doc": "screen_back_poo() - go back (no-op on the first screen)"},
    "screen_data_set":   {"min": 2, "max": 2, "arg_types": ["str", "any"], "doc": "screen_data_set(key, value) - shared in-memory data for screen-to-screen passing"},
    "screen_data_get":   {"min": 1, "max": 2, "arg_types": ["str", "any"], "doc": "screen_data_get(key, default=null)"}
  },
  "not_implemented": ["api_get", "api_post", "api_put", "api_delete", "api_json", "dialog_kaattu", "app_icon_set", "app_config", "state_uruvakku", "state_get", "state_set", "ui_refresh", "screen_refresh", "vadivelu_mode", "enna_kodumai_debug", "summa_adirudhulla", "gradient_set", "shadow_set"]
}
