      "container": false,
      "positional": [
        {
          "name": "label",
          "type": "str",
          "required": true
        }
      ],
      "kwargs": {
        "icon": "str"
      },
      "events": [
        "click_pannumbodhu"
      ],
      "style_groups": [
        "box",
        "text"
      ],
      "doc": "nav_action(label, icon=\"\", click_pannumbodhu=handler) - a button on the right of the top bar; only inside navbar_uruvakku (an icon replaces the label on the bar)"
    },
    "tabbar_uruvakku": {
      "container": true,
      "positional": [],
      "kwargs": {},
      "events": [],
      "style_groups": [
        "box",
        "text"
      ],
      "doc": "tabbar_uruvakku(style={}): <tab_item children> - bottom tab bar of this screen"
    },
    "tab_item": {
      "container": false,
      "positional": [
        {
          "name": "label",
          "type": "str",
          "required": true
        }
      ],
      "kwargs": {
        "icon": "str",
        "go": "str",
        "active": "bool"
      },
      "events": [
        "click_pannumbodhu"
      ],
      "style_groups": [
        "box",
        "text"
      ],
      "doc": "tab_item(label, icon=\"\", go=\"screen\", click_pannumbodhu=handler, active=...) - a tab; only inside tabbar_uruvakku. go switches to that screen (no back history); active is automatic when go is the current screen"
    }
  },
  "screen_functions": {
    "screen_title": {
      "min": 1,
      "max": 1,
      "doc": "screen_title(text) - app bar title of the current screen (inside a screen block)"
    }
  },
